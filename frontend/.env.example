# Copy to .env.local and fill in. All values are public (shipped to the browser);
# never put private keys or secrets in NEXT_PUBLIC_* variables.

# 31337 = local Hardhat node (default), 11155111 = Sepolia testnet
NEXT_PUBLIC_CHAIN_ID=31337

# Optional RPC URL. Leave empty to use the chain's default
# (http://127.0.0.1:8545 for Hardhat).
NEXT_PUBLIC_RPC_URL=

# Deployed contract addresses (printed by `npm run deploy:local` in contracts/)
NEXT_PUBLIC_TIPJAR_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_TIPTOKEN_ADDRESS=0x0000000000000000000000000000000000000000
