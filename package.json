{
  "name": "web3-tipjar",
  "version": "1.0.0",
  "description": "Small tip jar dApp: Solidity contracts (Hardhat 3) and a Next.js + wagmi frontend",
  "private": true,
  "scripts": {
    "install:all": "npm ci --prefix contracts && npm ci --prefix frontend",
    "compile": "npm run compile --prefix contracts",
    "test": "npm test --prefix contracts",
    "coverage": "npm run coverage --prefix contracts",
    "node": "npm run node --prefix contracts",
    "deploy:local": "npm run deploy:local --prefix contracts",
    "export-abis": "npm run export-abis --prefix contracts",
    "dev": "npm run dev --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "build": "npm run build --prefix frontend"
  }
}
